<?php
require_once __DIR__.'/includes/bootstrap.php';

$raw = $_GET['domain'] ?? $_POST['domain'] ?? 'yourbusiness';
$domain = domain_query_normalize($raw);
$parts = explode('.', $domain, 2);
$sld = preg_replace('/[^a-z0-9-]/i', '', $parts[0] ?? '');
if ($sld === '') $sld = 'yourbusiness';
$selectedExt = strtolower(trim((string)($_GET['extension'] ?? '')));
$selectedExt = $selectedExt !== '' ? '.'.ltrim($selectedExt,'.') : '';

$allPrices = fetch_domain_prices($db);
$prices = $selectedExt ? array_values(array_filter($allPrices, fn($p)=>strtolower($p['tld']) === $selectedExt)) : $allPrices;
$allTlds = array_map(fn($p)=>ltrim($p['tld'],'.'), $prices);
$availability = registrar_check_availability_batch($sld, $allTlds);

$results=[];
foreach($prices as $p){
    $key=$sld.strtolower($p['tld']);
    $r=$availability[$key] ?? ['success'=>false,'available'=>null,'status'=>'unknown','domain'=>$key];
    $results[]=[
        'name'=>$key,
        'tld'=>$p['tld'],
        'available'=>$r['available'] ?? null,
        'status'=>$r['status'] ?? 'unknown',
        'price'=>$p['registration_price'],
        'currency'=>$p['currency'] ?? 'BDT',
        'desc'=>$p['description'],
        'premium'=>$r['premium'] ?? false,
        'configured'=>$r['configured'] ?? false,
        'error'=>$r['error'] ?? null,
    ];
}

$lookupFailures = count(array_filter($results, fn($r)=>in_array($r['status'],['api_error','not_configured','unknown'],true)));
$registeredCount = count(array_filter($results, fn($r)=>$r['available'] === false));
$availableCount = count(array_filter($results, fn($r)=>$r['available'] === true));
$cartItems = cart_items();

function domain_status_text(array $r): string {
    return match ($r['status'] ?? '') {
        'regthroughus','regthroughothers' => 'Registered',
        'unknown','api_error','not_configured' => 'Check Again',
        default => 'Unavailable',
    };
}

