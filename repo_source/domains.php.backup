<script src="assets/js/app.js?v=wdh-ui-v8"></script>
<script>
(function(){
  const rows=[...document.querySelectorAll('.domain-result')], tabs=[...document.querySelectorAll('.domain-tab')];
  const available=document.getElementById('availableOnly'), premium=document.getElementById('premiumOnly'), no=document.getElementById('noDomainResults');
  let tab='all';
  function filter(){
    const price=(document.querySelector('input[name="price"]:checked')||{}).value||'all'; let shown=0;
    rows.forEach(r=>{
      const p=parseFloat(r.dataset.price||'0'), a=r.dataset.available, key=tab;
      const tabOk=key==='all'||r.dataset[key]==='1';
      const availOk=!available.checked||a==='1', premOk=!premium.checked||r.dataset.premium==='1';
      const priceOk=price==='all'||(price==='under1000'&&p<1000)||(price==='1000-2000'&&p>=1000&&p<=2000)||(price==='2000-5000'&&p>2000&&p<=5000)||(price==='over5000'&&p>5000);
      const ok=tabOk&&availOk&&premOk&&priceOk; r.hidden=!ok; if(ok) shown++;
    }); no.hidden=shown!==0;
  }
  tabs.forEach(t=>t.addEventListener('click',()=>{tabs.forEach(x=>x.classList.remove('active'));t.classList.add('active');tab=t.dataset.tab; const radio=document.querySelector('input[name="filter"][value="'+tab+'"]'); if(radio) radio.checked=true; filter();}));
  document.querySelectorAll('input[name="filter"]').forEach(r=>r.addEventListener('change',()=>{tab=r.value;tabs.forEach(x=>x.classList.toggle('active',x.dataset.tab===tab));filter();}));
  document.querySelectorAll('input[name="price"]').forEach(r=>r.addEventListener('change',filter)); available.addEventListener('change',filter); premium.addEventListener('change',filter);
  document.getElementById('clearDomainFilters').addEventListener('click',()=>{document.querySelector('input[name="filter"][value="all"]').checked=true;document.querySelector('input[name="price"][value="all"]').checked=true;available.checked=false;premium.checked=false;tab='all';tabs.forEach(x=>x.classList.toggle('active',x.dataset.tab==='all'));filter();});
  const ft=document.getElementById('filterToggle'), fc=document.getElementById('domainFilters'); if(ft) ft.addEventListener('click',()=>fc.classList.toggle('filter-open'));
  document.querySelectorAll('.retry-domain').forEach(btn=>btn.addEventListener('click',()=>{const d=btn.dataset.domain; window.location.href='domains.php?domain='+encodeURIComponent(d); }));
  filter();
})();
</script>
</body></html>
