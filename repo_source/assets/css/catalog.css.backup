.payment-option{display:block;border:1px solid var(--line);padding:14px;border-radius:9px;margin:9px 0;font-size:12px}.muted{color:var(--muted);font-size:10px}
.admin-row-wide,.admin-row-product{align-items:flex-start;flex-wrap:wrap}.admin-row-wide label,.admin-row-product label{min-width:130px;flex:1}.admin-row-product textarea{width:100%;resize:vertical;min-height:58px}.admin-row-product label:nth-last-of-type(2){min-width:260px;flex:2}.admin-row-wide label:nth-of-type(4){min-width:220px;flex:2}
.payment-extra{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:14px 0}.payment-extra label{display:flex;flex-direction:column;gap:6px}.payment-extra input{padding:11px;border:1px solid var(--border,#dfe7f1);border-radius:10px}@media(max-width:700px){.payment-extra{grid-template-columns:1fr}}
.admin-stats{margin:18px 0}.admin-stats .dash-card strong{font-size:1.55rem}.admin-row .btn{white-space:nowrap}
.success-icon{width:68px;height:68px;border-radius:50%;display:inline-grid;place-items:center;background:#e9fbf3;color:#15966a;font-size:34px;font-weight:800;margin-bottom:14px}.admin-row textarea,.admin-row input,.admin-row select{min-width:0}.admin-row input{padding:10px;border:1px solid #dfe7ef;border-radius:10px}.alert{border-radius:12px;padding:13px 15px;margin:14px 0}.alert.error{background:#fff1f2;color:#a61b2b;border:1px solid #ffd1d6}.success-alert{background:#ecfdf5;color:#087a50;border:1px solid #b9efd9}.payment-option{display:block;padding:12px;border:1px solid #e4ebf2;border-radius:12px;margin:8px 0}.payment-extra{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}@media(max-width:700px){.payment-extra{grid-template-columns:1fr}.admin-row{grid-template-columns:1fr!important}}

.server-meta{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0}.server-meta span{display:inline-flex;align-items:center;padding:6px 9px;border-radius:999px;background:#f2f7ff;border:1px solid #dbeafe;font-size:12px;color:#334155}.server-meta span:nth-child(2){background:#f0fdf4;border-color:#bbf7d0}.server-meta span:nth-child(3){background:#fff7ed;border-color:#fed7aa}
.notification-list{display:grid;gap:14px}.notification-item{display:flex;justify-content:space-between;gap:24px;align-items:center;padding:22px;border:1px solid rgba(20,40,70,.10);border-radius:18px;background:#fff;box-shadow:0 8px 30px rgba(20,40,70,.05)}.notification-item.unread{border-left:4px solid #19b394}.notification-item.read{opacity:.82}.notification-item h3{margin:5px 0 7px}.notification-item p{margin:0 0 8px}.notification-item .actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.credential-card{position:relative}.secret-field{display:flex;align-items:center;gap:8px}.secret-field input{flex:1;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.secret-field button{white-space:nowrap}.security-note{padding:12px 14px;border-radius:12px;background:rgba(25,179,148,.08);font-size:.92rem}.service-meta-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.service-meta{padding:16px;border-radius:14px;background:#f7fafc}.service-meta span{display:block;font-size:.8rem;opacity:.7;margin-bottom:5px}.service-meta strong{font-size:1rem}@media(max-width:760px){.notification-item{display:block}.notification-item .actions{margin-top:15px}.service-meta-grid{grid-template-columns:1fr}}
.report-filter{display:flex;align-items:end;gap:12px;flex-wrap:wrap;margin:18px 0;padding:16px;border:1px solid var(--line,#e5eaf0);border-radius:16px;background:#fff}.report-filter label{display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:700}.report-filter input{padding:10px 12px;border:1px solid #dfe7ef;border-radius:10px}.badge{display:inline-flex;align-items:center;padding:6px 10px;border-radius:999px;background:#eef6ff;border:1px solid #d8e9ff;font-size:12px;text-transform:capitalize}.admin-section{margin-top:24px}
.ticket-thread{display:grid;gap:14px}.ticket-message{padding:16px 18px;border:1px solid rgba(80,110,150,.14);border-radius:14px;background:#fff}.ticket-message.internal{background:#fff8e7;border-color:#f4d48b}.ticket-message-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:8px;font-size:.9rem}.ticket-message-head span{color:#64748b;font-size:.78rem}.small{font-size:.82rem}.detail-line>div{display:flex;flex-direction:column;gap:4px}.detail-line>a{align-self:center}@media(max-width:700px){.ticket-message-head{display:block}.ticket-message-head span{display:block;margin-top:4px}}

/* V7 catalog/form restoration */
code{padding:2px 5px;border-radius:5px;background:#eef4fb;color:#24405f;font-size:.9em}
.catalog-page,.product-page,.portal-page,.admin-page,.simple-page{position:relative}
.catalog-page .alert,.product-page .alert,.portal-page .alert,.admin-page .alert,.simple-page .alert{font-size:11px}
.filter-card label input[type=radio],.filter-card label input[type=checkbox]{width:auto;max-width:none}
.filter-card label input{margin:0}
.data-table{width:100%;border-collapse:collapse;background:#fff}
.data-table th,.data-table td{padding:10px 12px;border-bottom:1px solid var(--line);text-align:left;font-size:10px}
.data-table th{font-size:9px;text-transform:uppercase;letter-spacing:.35px;color:#71839a;background:#f8fbff}
.data-table tr:last-child td{border-bottom:0}
@media(max-width:720px){.data-table{display:block;overflow-x:auto;white-space:nowrap}.data-table th,.data-table td{font-size:9px}}
